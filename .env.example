# CARF Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - Phase 1 MVP
# =============================================================================

# LLM Provider: deepseek | openai | anthropic | google | mistral | ollama | together
LLM_PROVIDER=deepseek

# DeepSeek API Key (recommended - cost-efficient)
DEEPSEEK_API_KEY=sk-...

# OpenAI API Key
# OPENAI_API_KEY=sk-...

# Anthropic API Key (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# Google API Key (Gemini)
# GOOGLE_API_KEY=AI...

# Mistral API Key
# MISTRAL_API_KEY=...

# Together AI API Key (open-source models)
# TOGETHER_API_KEY=...

# Ollama: no API key needed, runs locally on http://localhost:11434

# HumanLayer API Key (for human-in-the-loop)
HUMANLAYER_API_KEY=hl_...

# =============================================================================
# OPTIONAL - Observability
# =============================================================================

# LangSmith (tracing)
LANGSMITH_API_KEY=ls-...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=carf-dev

# =============================================================================
# PHASE 2+ - Database Integrations
# =============================================================================

# Neo4j (Causal Graph) - Phase 3
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# Redis (Short-term Memory)
# REDIS_URL=redis://localhost:6379

# PostgreSQL (Epistemic State)
# DATABASE_URL=postgresql://user:pass@localhost:5432/carf

# =============================================================================
# PHASE 3+ - Production
# =============================================================================

# Kafka (Audit Trail)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_TOPIC=carf_decisions
# KAFKA_CLIENT_ID=carf
# KAFKA_ENABLED=false

# OPA (Guardian Policy)
# OPA_ENABLED=false
# OPA_URL=http://localhost:8181
# OPA_POLICY_PATH=/v1/data/carf/guardian/allow
# OPA_TIMEOUT_SECONDS=5

# CSL-Core (Formal Policy Verification)
# CSL_ENABLED=false
# CSL_POLICY_DIR=config/policies
# CSL_FAIL_CLOSED=true
# CSL_AUDIT_ENABLED=true

# Test mode (offline LLM stubs)
# CARF_TEST_MODE=1

# Slack (HumanLayer channel)
# SLACK_WEBHOOK_URL=

# Dataset registry (local storage)
# CARF_DATA_DIR=./var

# =============================================================================
# OPTIONAL - Decision-model router shadow (log-only, off by default)
# =============================================================================
# After the router decides, asks a local decision model (llama.cpp /v1/systemone)
# the same routing question and logs its answer next to CARF's decision. It never
# changes routing, never writes to EpistemicState, and fails open (one attempt per
# model, no retry). See src/services/router_shadow.py.
# CARF_ROUTER_SHADOW=1
# CARF_ROUTER_SHADOW_URL=http://127.0.0.1:18195
# Comma list; one log row per model, e.g. vllm-d3,kev-4b
# CARF_ROUTER_SHADOW_MODELS=vllm-d3
# Total seconds per call
# CARF_ROUTER_SHADOW_TIMEOUT_S=1.5
# 1 = wait for the shadow inside classify() (batch and benchmark runs only)
# CARF_ROUTER_SHADOW_AWAIT=0
# 1 = also log a scrubbed 200-character excerpt (default: sha256 of the text only)
# CARF_ROUTER_SHADOW_LOG_TEXT=0
# Calibration key (default: DECISION_SHADOW_MACHINE, then the hostname)
# CARF_ROUTER_SHADOW_MACHINE=
# Log directory for carf.jsonl (default: $CARF_DATA_DIR/decision-shadow, else ./var/decision-shadow)
# DECISION_SHADOW_DIR=
